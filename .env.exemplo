# Cadastre estas variáveis em Netlify > Site configuration > Environment variables (NUNCA no código)
ADMIN_SENHA=                # senha do seu painel (admin.html): mínimo 10 caracteres, só você sabe
MP_ACCESS_TOKEN=            # Mercado Pago > Credenciais de produção > Access Token
MP_WEBHOOK_SECRET=          # Mercado Pago > Webhooks > chave secreta (opcional)
SF_TOKEN=                   # SuperFrete > Integrações > Nova integração > API > Gerar token
SF_SANDBOX=0                # 1 para testar no ambiente de testes da SuperFrete (token de sandbox)
CEP_ORIGEM=                 # CEP de onde você despacha (8 números)
CONTATO_EMAIL=              # e-mail do seu cadastro na SuperFrete
SITE_URL=                   # ex.: https://seusite.netlify.app (sem barra no fim)
# Só se o painel avisar que o armazenamento não funciona: BLOBS_SITE_ID (ID do projeto) e BLOBS_TOKEN (token pessoal do Netlify)
# Opcional: SF_SERVICOS=1,2,17  (1 PAC, 2 SEDEX, 17 Mini Envios)
